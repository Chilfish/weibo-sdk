{
  "name": "weibo-sdk",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.2",
  "description": "A maintainable, offline-testable Weibo reverse-engineering SDK in TypeScript.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/weibo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/weibo-sdk.git"
  },
  "bugs": "https://github.com/Chilfish/weibo-sdk/issues",
  "keywords": [
    "weibo",
    "sdk",
    "typescript",
    "reverse-engineering"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint . --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "dotenv": "catalog:",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:utils",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "unbuild": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing",
    "zod": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
