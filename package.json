{
  "name": "weibo-sdk",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "description": "A maintainable, offline-testable Weibo reverse-engineering SDK in TypeScript.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/weibo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/weibo-sdk.git"
  },
  "bugs": "https://github.com/Chilfish/weibo-sdk/issues",
  "keywords": [
    "weibo",
    "sdk",
    "typescript",
    "reverse-engineering"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "weibo-sdk": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "./dist/index.mjs",
      "limit": "50 kB"
    }
  ],
  "dependencies": {
    "axios": "catalog:",
    "citty": "^0.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "dotenv": "catalog:",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:utils",
    "tsdown": "^0.22.0",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
