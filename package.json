{
  "name": "@chilfish/weibo-sdk",
  "type": "module",
  "version": "0.1.1",
  "description": "A maintainable, offline-testable Weibo reverse-engineering SDK in TypeScript.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/weibo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/weibo-sdk.git"
  },
  "bugs": "https://github.com/Chilfish/weibo-sdk/issues",
  "keywords": [
    "weibo",
    "sdk",
    "typescript",
    "reverse-engineering"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/index.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "weibo-cli": "./dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "capture": "tsx capture/bin/index.ts",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "prepublishOnly": "node scripts/verify-publish-tool.mjs && nr build",
    "release": "bumpp && pnpm publish",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "catalog:",
    "citty": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "dotenv": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:utils",
    "tsdown": "catalog:utils",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
