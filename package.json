{
  "name": "@chilfish/weibo-sdk",
  "type": "module",
  "version": "0.3.2",
  "packageManager": "pnpm@12.5.1",
  "description": "A maintainable, offline-testable Weibo reverse-engineering SDK in TypeScript.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/weibo-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/weibo-sdk.git"
  },
  "bugs": "https://github.com/Chilfish/weibo-sdk/issues",
  "keywords": [
    "weibo",
    "sdk",
    "typescript",
    "reverse-engineering"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/index.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "weibo-cli": "./dist/cli-bin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "tsdown",
    "capture": "tsx capture/bin/index.ts",
    "capture:endpoint": "tsx scripts/capture-endpoint.ts",
    "archive:user": "tsx scripts/archive-user/index.ts",
    "new:endpoint": "node scripts/new-endpoint.mjs",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "lint:package": "node scripts/lint-package.mjs",
    "play": "tsx playground/run.ts",
    "prepublishOnly": "node scripts/verify-publish-tool.mjs && nr build",
    "release": "node scripts/release.mjs",
    "schema:archive": "ts-json-schema-generator --path src/types/archive/IArchiveFile.ts --type ArchiveFile --tsconfig tsconfig.json --no-type-check --additional-properties --markdown-description --no-top-ref --id https://raw.githubusercontent.com/Chilfish/weibo-sdk/main/schemas/weibo-user-archive/v2.json -o schemas/weibo-user-archive/v2.json",
    "schema:check": "pnpm schema:archive && git diff --exit-code -- schemas/weibo-user-archive/v2.json",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "test:bundle": "node scripts/test-bundle.mjs",
    "test:e2e": "vitest --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@types/node": "catalog:types",
    "ajv": "catalog:utils",
    "bumpp": "catalog:cli",
    "citty": "catalog:",
    "dotenv": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:utils",
    "ts-json-schema-generator": "catalog:utils",
    "tsdown": "catalog:utils",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "inlinedDependencies": {
    "citty": "0.2.2"
  }
}
