# 复制为 playground/.env（或项目根目录 .env）。
# CLI 与 SDK 示例都只从 .env 读取 Cookie，不读取 shell 环境变量。

# 1) Cookie header 串（从已登录浏览器的开发者工具复制）
WEIBO_COOKIE="SUB=xxx; SUBP=xxx; XSRF-TOKEN=xxx"

# 2) 或 Netscape cookies.txt / header 串文本文件路径
# WEIBO_COOKIE="C:/Users/me/cookies.txt"

# 可选：演示账号 / 微博（默认是仓库测试用的公开样本）
# PLAYGROUND_UID=1111681197
# PLAYGROUND_MBLOG_ID=QqsYymYOS
